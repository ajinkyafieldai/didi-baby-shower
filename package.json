{
  "name": "didi-baby-shower",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/verify-build.mjs",
    "photobooth": "python3 server/daily_photobooth.py",
    "transcript:map": "node scripts/phrase-map.mjs",
    "trigger": "node babyshower.js trigger",
    "transcript:local": "bash scripts/run-local-transcript.sh",
    "transcript:sources": "bash scripts/list-audio-sources.sh",
    "transcript:tmux": "bash scripts/transcript-tmux.sh",
    "photobooth:live-test": "python3 scripts/test-daily-family-photo.py"
  },
  "devDependencies": {
    "vite": "^7.1.7"
  },
  "bin": {
    "babyshower": "./babyshower.js"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  }
}
