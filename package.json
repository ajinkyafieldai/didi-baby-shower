{
  "name": "didi-baby-shower",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/verify-build.mjs",
    "photobooth": "node photobooth.js run",
    "photobooth:capture": "node photobooth.js capture",
    "photobooth:health": "node photobooth.js health",
    "transcript:map": "node scripts/phrase-map.mjs",
    "trigger": "node babyshower.js trigger",
    "rtms:transcript": "node scripts/rtms-transcript.mjs",
    "rtms:sim": "node scripts/rtms-transcript-sim.mjs",
    "rtms:local": "bash scripts/run-transcript-local.sh",
    "transcript:local": "bash scripts/run-local-transcript.sh",
    "transcript:sources": "bash scripts/list-audio-sources.sh",
    "transcript:tmux": "bash scripts/transcript-tmux.sh"
  },
  "dependencies": {
    "@zoom/meetingsdk": "^6.5.0",
    "@zoom/rtms": "^1.1.0"
  },
  "devDependencies": {
    "vite": "^7.1.7"
  },
  "bin": {
    "babyshower": "./babyshower.js"
  }
}
