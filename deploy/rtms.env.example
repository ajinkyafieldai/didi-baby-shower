# Copy to /etc/babyshower/rtms.env and chmod 600.
# Do not commit real credentials.

ZM_RTMS_CLIENT=
ZM_RTMS_SECRET=
ZM_RTMS_PORT=8080
ZM_RTMS_PATH=/webhook

BABYSHOWER_URL=https://event.example.com
BABYSHOWER_LOG_DIR=/var/log/babyshower
