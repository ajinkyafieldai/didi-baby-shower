# Copy to /etc/babyshower/rtms.env and chmod 600.
# Do not commit real credentials.

ZM_RTMS_CLIENT=
ZM_RTMS_SECRET=
ZM_RTMS_PORT=8080
ZM_RTMS_PATH=/webhook

BABYSHOWER_URL=https://event.example.com
BABYSHOWER_LOG_DIR=/var/log/babyshower
# BABYSHOWER_TRANSCRIPT_LANGUAGE=ENGLISH
# BABYSHOWER_PHRASE_COOLDOWN_MS=8000

# Optional comma-separated Zoom display names allowed to drive transcript triggers.
# Leave empty to accept transcript from every speaker.
# BABYSHOWER_ALLOWED_SPEAKERS=Host Name,Another Host

# Duplicate RTMS line suppression window.
# BABYSHOWER_TRANSCRIPT_DUPLICATE_MS=5000

# Per-trigger overrides. Falls back to BABYSHOWER_PHRASE_COOLDOWN_MS.
# BABYSHOWER_COOLDOWN_PHOTO_SHOW_MS=8000
# BABYSHOWER_COOLDOWN_CELEBRATE_MS=8000
