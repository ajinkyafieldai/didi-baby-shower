[Unit]
Description=Babyshower local Whisper transcript pipeline
After=pipewire.service pipewire-pulse.service
Wants=pipewire.service pipewire-pulse.service

[Service]
Type=simple
WorkingDirectory=__REPO_DIR__
Environment=BABYSHOWER_ENV_FILE=__REPO_DIR__/.env
Environment=BABYSHOWER_WHISPER_VENV=__REPO_DIR__/.venv-whisper
ExecStart=/usr/bin/bash __REPO_DIR__/scripts/run-local-transcript.sh
Restart=always
RestartSec=3

# Keep the process tied to the logged-in desktop user so it can access PipeWire.
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
