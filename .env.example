# Local development only. Copy to .env and fill in real values.
# .env is gitignored.
#
# WHEREBY_API_KEY is a Cloudflare Pages secret, not a browser/local CLI value.
# Room creation is deliberate via `babyshower room create`.

BABYSHOWER_URL=https://event.example.com
BABYSHOWER_LOG_DIR=./logs

# Optional
# BABYSHOWER_TRANSCRIPT_LANGUAGE=ENGLISH
# BABYSHOWER_ALLOWED_SPEAKERS=Host Name
# BABYSHOWER_PHRASE_COOLDOWN_MS=8000
# BABYSHOWER_TRANSCRIPT_DUPLICATE_MS=5000
# BABYSHOWER_COOLDOWN_PHOTO_SHOW_MS=8000
# BABYSHOWER_COOLDOWN_CELEBRATE_MS=8000

# Local Whisper transcript source
# Use "npm run transcript:sources" and choose a .monitor source for meeting/system audio.
# BABYSHOWER_AUDIO_SOURCE=alsa_output.pci-0000_00_1f.3.analog-stereo.monitor
# BABYSHOWER_WHISPER_MODEL=small
# BABYSHOWER_WHISPER_LANGUAGE=
# BABYSHOWER_WHISPER_ALLOWED_LANGUAGES=en,mr,hi
# BABYSHOWER_WHISPER_CHUNK_SECONDS=2.5
# BABYSHOWER_WHISPER_CONTEXT_SECONDS=5
# BABYSHOWER_WHISPER_DEVICE=cpu
# BABYSHOWER_WHISPER_COMPUTE_TYPE=int8
